# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=

# Voice clips (scripts/record-lines.ts, scripts/record-voiceover.ts).
# Backend picked in this order: ElevenLabs, then OpenAI TTS, then macOS `say`.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_NARRATOR=
# Only used as the TTS fallback when there is no ElevenLabs key.
OPENAI_API_KEY=
